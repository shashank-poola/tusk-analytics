{
  "name": "next-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "prettier --check \"**/*.{ts,tsx}\" \".claude/**/*.{md,json,ts}\" \".github/**/*.{yml,md}\" AGENTS.md CLAUDE.md",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:tooling": "bun test ./scripts/ ./.claude/scripts/",
    "validate:agents": "bun scripts/validate-agent-files.ts",
    "check:migrations": "bun scripts/check-migrations.ts",
    "check:tracker-size": "bun scripts/check-tracker-size.ts",
    "tracker:dev": "bun packages/tracker/test-page/serve.ts",
    "db:generate": "bun run --filter @workspace/db db:generate",
    "db:migrate": "bun run --filter @workspace/db db:migrate",
    "db:migrate:remote": "bun run --filter @workspace/db db:migrate:remote",
    "db:studio": "bun run --filter @workspace/db db:studio",
    "db:seed": "bun scripts/seed-events.ts"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^7"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
