{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply viewtally --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply viewtally --remote",
    "db:studio": "drizzle-kit studio",
    "db:studio:remote": "DB_TARGET=remote drizzle-kit studio",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@libsql/client": "^0.18.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "typescript": "^7",
    "wrangler": "^4.147.0"
  }
}
