# Git for Windows defaults to core.autocrlf=true, which checks text files out
# with CRLF. Prettier, bun and the hook scripts expect LF, so force it.
* text=auto eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.css text eol=lf

bun.lock text eol=lf linguist-generated
packages/db/migrations/meta/*.json linguist-generated

*.ico binary
*.png binary
*.jpg binary
*.woff2 binary
