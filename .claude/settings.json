{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun run dev *)",
      "Bash(bun run build *)",
      "Bash(bun run lint *)",
      "Bash(bun run format *)",
      "Bash(bun run format:check *)",
      "Bash(bun run typecheck *)",
      "Bash(bun run test *)",
      "Bash(bun run test:tooling *)",
      "Bash(bun run validate:agents *)",
      "Bash(bun run check:migrations *)",
      "Bash(bun run check:tracker-size *)",
      "Bash(bun run db:generate *)",
      "Bash(bun run db:migrate)",
      "Bash(bun run db:studio)",
      "Bash(bunx vitest run *)",
      "Bash(bunx tsc --noEmit *)",
      "Bash(bunx prettier --check *)",
      "Bash(bun test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(bun run lint *)",
      "PowerShell(bun run typecheck *)",
      "PowerShell(bun run test *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "deny": [
      "Read(**/.dev.vars*)",
      "Read(**/.env*)",
      "Read(!**/.env.example)",
      "Edit(**/.dev.vars*)",
      "Edit(**/.env*)",
      "Edit(!**/.env.example)",
      "Edit(/packages/db/migrations/meta/**)",

      "Bash(*db:migrate:remote*)",
      "Bash(*db:studio:remote*)",
      "Bash(*DB_TARGET=remote*)",
      "Bash(*--remote*)",
      "Bash(*wrangler secret *)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler rollback*)",
      "Bash(*wrangler pages deploy*)",
      "Bash(*wrangler d1 time-travel restore*)",
      "Bash(*opennextjs-cloudflare deploy*)",
      "Bash(*drizzle-kit push*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(*--force*)",
      "Bash(*--no-verify*)",

      "PowerShell(*db:migrate:remote*)",
      "PowerShell(*db:studio:remote*)",
      "PowerShell(*--remote*)",
      "PowerShell(*wrangler secret *)",
      "PowerShell(*wrangler deploy*)",
      "PowerShell(*wrangler versions deploy*)",
      "PowerShell(*wrangler rollback*)",
      "PowerShell(*drizzle-kit push*)",
      "PowerShell(git push*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(*--force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/scripts/guard-bash.ts"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/scripts/guard-write.ts"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/scripts/format.ts"],
            "timeout": 60,
            "statusMessage": "Formatting with Prettier"
          }
        ]
      }
    ]
  }
}
