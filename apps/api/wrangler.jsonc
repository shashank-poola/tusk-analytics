{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viewtally-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth needs AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Deploys are production. `bun run dev` overrides this with
  // `--var ENVIRONMENT:development`.
  "vars": { "ENVIRONMENT": "production" },
  // Wrangler runs this before dev and deploy (including CI's dry run), so
  // public/script.js always exists, and reruns it in dev when the tracker's
  // source changes.
  "build": {
    "command": "bun run build",
    "cwd": "../../packages/tracker",
    "watch_dir": "../../packages/tracker/src",
  },
  // Serves public/script.js (the tracker) at /script.js without invoking the
  // Worker. Paths with no file, like /api/*, still reach the Worker. Headers
  // for these files are set in public/_headers.
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "viewtally",
      "database_id": "79b7de41-66a2-4048-9b5d-f93ddd5c907f",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
}
